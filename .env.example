# ---- Database ----
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_local_dev
POSTGRES_DB=support_chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://chatbot:chatbot_local_dev@localhost:5434/support_chatbot

# ---- DeepSeek (generation only; embeddings/rerank run locally) ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Local models (CPU) ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Retrieval tuning ----
RETRIEVAL_CANDIDATES=10
RETRIEVAL_TOP_K=3
CONFIDENCE_THRESHOLD=0.10

# Staff session lifetime, and DeepSeek pricing used to populate
# message_traces.cost_usd. Update the prices if DeepSeek changes them.
SESSION_TTL_HOURS=12
PRICE_IN_PER_1M=0.27
PRICE_OUT_PER_1M=1.10

# ---- App ----
APP_ENV=local
AUTH_SESSION_SECRET=change-me-in-production-32-chars-min
WIDGET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
DEFAULT_TENANT=mof-contracts

# ---- Security ----
# CIDRs whose X-Forwarded-For may be trusted (e.g. "127.0.0.1/32,10.0.0.0/8").
# Empty = app is exposed directly, header ignored.
TRUSTED_PROXIES=
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
REFUSAL_THRESHOLD=0.05
